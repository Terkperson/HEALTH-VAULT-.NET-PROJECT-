@page "/staff/patients"
@attribute [Authorize(Roles = $"{UserRoles.Staff},{UserRoles.Administrator}")]
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService Toast

<div class="page-header">
    <h1 class="page-title">Patients</h1>
    <p class="lede">Search by name, email, phone or Ghana Card.</p>
</div>

<div class="card">
    <div class="row g-2">
        <div class="col-md-8">
            <input class="form-control" placeholder="Search patients…" @bind="query" @bind:event="oninput" @onkeyup="HandleKeyPress" style="padding-left: 40px; background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2216%22 height=%2216%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23999%22 stroke-width=%222%22><circle cx=%2211%22 cy=%2211%22 r=%228%22/><path d=%22m21 21-4.35-4.35%22/></svg>'); background-repeat: no-repeat; background-position: 12px center;" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-teal w-100" @onclick="Search">Search</button>
        </div>
        <div class="col-md-2">
            <a class="btn btn-outline-secondary w-100" href="/staff/patients/new">➕ New patient</a>
        </div>
    </div>
</div>

<div class="card">
    @if (loading)
    {
        <div class="empty-state">
            <div style="font-size: 48px; margin-bottom: 16px;">⏳</div>
            <p>Loading patients...</p>
        </div>
    }
    else if (results is null || !results.Items.Any())
    {
        <div class="empty-state">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; color: var(--muted);">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <h3>No patients found</h3>
            <p>@(string.IsNullOrWhiteSpace(query) ? "No patients registered yet" : "No patients match your search")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in results.Items)
                {
                    <tr>
                        <td style="font-weight: 600;">@p.FullName</td>
                        <td>@p.Age</td>
                        <td>@p.Phone</td>
                        <td><small>@p.Email</small></td>
                        <td>@p.City</td>
                        <td style="white-space: nowrap;">
                            <a href="@EditUrl(p.Id)" class="btn btn-sm btn-outline-secondary" style="margin-right: 4px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle;">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                                Edit
                            </a>
                            <a href="@RecordUrl(p.Id)" class="btn btn-sm btn-outline-secondary">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle;">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                                Records
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div style="padding-top: 12px; border-top: 1px solid rgba(215, 227, 223, 0.4); color: var(--muted); font-size: 14px;">
            <strong>@results.TotalCount</strong> patient@(results.TotalCount == 1 ? "" : "s") found
        </div>
    }
</div>

@code {
    private string? query;
    private PagedResult<PatientDto>? results;
    private bool loading = false;

    protected override Task OnInitializedAsync() => Search();

    private async Task Search()
    {
        loading = true;
        var result = await Api.SearchPatientsAsync(query);
        loading = false;
        
        if (result.Success) 
        {
            results = result.Data;
        }
        else
        {
            Toast.ShowError(result.Message ?? "Failed to search patients", "Error");
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private static string EditUrl(Guid id) => $"/staff/patients/{id}";
    private static string RecordUrl(Guid id) => $"/records/{id}";
}
