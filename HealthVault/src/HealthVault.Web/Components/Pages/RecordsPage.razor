@page "/records"
@page "/records/{PatientId:guid}"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
@inject IJSRuntime Js
@inject ToastService Toast

<h1 class="page-title">Medical records</h1>
<p class="lede">PDF, JPG, PNG or DOCX up to 10 MB. Category is fixed to General for the MVP.</p>

<div class="card">
    <h3>Upload</h3>
    <div class="row g-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Title" @bind="title" />
        </div>
        <div class="col-md-4">
            <input class="form-control" placeholder="Description (optional)" @bind="description" />
        </div>
        <div class="col-md-3">
            <InputFile class="form-control" OnChange="OnFile" accept=".pdf,.jpg,.jpeg,.png,.docx" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-teal w-100" @onclick="Upload" disabled="@(file is null || busy)">
                @if (busy)
                {
                    <span>...</span>
                }
                else
                {
                    <span>Go</span>
                }
            </button>
        </div>
    </div>
</div>

<div class="card">
    <RecordTable Items="items" OnDownload="Download" AllowDownload="true" />
</div>

@code {
    [Parameter] public Guid PatientId { get; set; }

    private IReadOnlyList<MedicalRecordDto> items = [];
    private IBrowserFile? file;
    private string title = "Clinical document";
    private string? description;
    private bool busy;
    private Guid resolvedPatient;

    protected override async Task OnInitializedAsync()
    {
        resolvedPatient = PatientId != Guid.Empty ? PatientId : Session.PatientId ?? Guid.Empty;
        if (resolvedPatient == Guid.Empty)
        {
            Toast.ShowWarning("No patient is selected", "No Patient");
            return;
        }
        await Reload();
    }

    private async Task Reload()
    {
        var result = await Api.ListRecordsAsync(resolvedPatient);
        if (result.Success && result.Data is not null) 
        {
            items = result.Data;
        }
        else 
        {
            Toast.ShowError(result.Message ?? "Failed to load records", "Error");
        }
    }

    private void OnFile(InputFileChangeEventArgs e)
    {
        file = e.File;
        if (file is not null)
        {
            Toast.ShowInfo($"Selected: {file.Name} ({file.Size / 1024}KB)", "File Selected");
        }
    }

    private async Task Upload()
    {
        if (file is null) return;
        busy = true;
        var result = await Api.UploadRecordAsync(resolvedPatient, title, description, file);
        busy = false;
        
        if (result.Success)
        {
            Toast.ShowSuccess($"{file.Name} uploaded successfully", "Upload Complete");
            file = null;
            title = "Clinical document";
            description = null;
            await Reload();
        }
        else
        {
            Toast.ShowError(result.Message ?? "Upload failed", "Upload Failed");
        }
    }

    private async Task Download(MedicalRecordDto record)
    {
        var (bytes, name, type, error) = await Api.DownloadRecordAsync(record.Id, record.OriginalFileName);
        if (bytes is null)
        {
            Toast.ShowError(error ?? "Download failed", "Download Failed");
            return;
        }
        var b64 = Convert.ToBase64String(bytes);
        var safeName = name.Replace("'", string.Empty);
        var script = "(() => { const a=document.createElement('a'); a.href='data:" + type + ";base64," + b64 + "'; a.download='" + safeName + "'; a.click(); })()";
        await Js.InvokeVoidAsync("eval", script);
        Toast.ShowSuccess($"Downloading {safeName}", "Download Started");
    }
}
