@page "/staff/appointments"
@attribute [Authorize(Roles = $"{UserRoles.Staff},{UserRoles.Administrator}")]
@inject ApiClient Api
@inject ToastService Toast

<div class="page-header">
    <h1 class="page-title">Appointments</h1>
    <p class="lede">Confirm, complete or cancel. Double-booking is rejected.</p>
</div>

<div class="card">
    <div style="margin-bottom: 20px;">
        <a class="btn btn-teal" href="/appointments/book">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 6px;">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Book for a patient
        </a>
    </div>
    
    @if (items.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Clinician</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td style="white-space: nowrap;">@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                        <td style="white-space: nowrap;">@item.StartTime.ToString("HH:mm")</td>
                        <td>
                            <div style="font-weight: 600;">@item.PatientName</div>
                            <small style="color: var(--muted);">@item.PatientPhone</small>
                        </td>
                        <td>@item.StaffName</td>
                        <td>@item.Reason</td>
                        <td><span class="badge-status s-@item.Status">@item.StatusName</span></td>
                        <td style="white-space: nowrap;">
                            @if (item.Status == 1)
                            {
                                <button class="btn btn-sm btn-teal" @onclick="() => SetStatus(item.Id, 2)" style="margin-right: 4px;">Confirm</button>
                            }
                            @if (item.Status is 1 or 2)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SetStatus(item.Id, 3)" style="margin-right: 4px;">Complete</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(item.Id)">Cancel</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; color: var(--muted);">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <h3>No appointments found</h3>
            <p>There are no appointments scheduled at the moment.</p>
        </div>
    }
</div>

@code {
    private IReadOnlyList<AppointmentDto> items = [];

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        var result = await Api.ListAppointmentsAsync();
        if (result.Success && result.Data is not null) 
        {
            items = result.Data;
        }
        else 
        {
            Toast.ShowError(result.Message ?? "Failed to load appointments", "Error");
        }
    }

    private async Task SetStatus(Guid id, byte status)
    {
        var result = await Api.UpdateStatusAsync(id, status);
        if (result.Success)
        {
            var statusName = status switch
            {
                2 => "confirmed",
                3 => "completed",
                _ => "updated"
            };
            Toast.ShowSuccess($"Appointment {statusName} successfully", "Success");
            await Reload();
        }
        else
        {
            Toast.ShowError(result.Message ?? "Failed to update status", "Error");
        }
    }

    private async Task Cancel(Guid id)
    {
        var result = await Api.CancelAppointmentAsync(id, "Cancelled by clinic staff");
        if (result.Success)
        {
            Toast.ShowSuccess("Appointment cancelled", "Cancelled");
            await Reload();
        }
        else
        {
            Toast.ShowError(result.Message ?? "Failed to cancel appointment", "Error");
        }
    }
}
