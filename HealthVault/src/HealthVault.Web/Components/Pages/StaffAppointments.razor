@page "/staff/appointments"
@attribute [Authorize(Roles = $"{UserRoles.Staff},{UserRoles.Administrator}")]
@inject ApiClient Api

<h1 class="page-title">Appointments</h1>
<p class="lede">Confirm, complete or cancel. Double-booking is rejected.</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

<div class="card">
    <a class="btn btn-teal mb-3" href="/appointments/book">Book for a patient</a>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Date</th><th>Time</th><th>Patient</th><th>Clinician</th><th>Reason</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                    <td>@item.StartTime.ToString("HH:mm")</td>
                    <td>@item.PatientName<br /><small>@item.PatientPhone</small></td>
                    <td>@item.StaffName</td>
                    <td>@item.Reason</td>
                    <td><span class="badge-status s-@item.Status">@item.StatusName</span></td>
                    <td>
                        @if (item.Status == 1)
                        {
                            <button class="btn btn-sm btn-teal" @onclick="() => SetStatus(item.Id, 2)">Confirm</button>
                        }
                        @if (item.Status is 1 or 2)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetStatus(item.Id, 3)">Complete</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(item.Id)">Cancel</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    private IReadOnlyList<AppointmentDto> items = [];
    private string? message;

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        var result = await Api.ListAppointmentsAsync();
        if (result.Success && result.Data is not null) items = result.Data;
        else message = result.Message;
    }

    private async Task SetStatus(Guid id, byte status)
    {
        var result = await Api.UpdateStatusAsync(id, status);
        message = result.Message;
        await Reload();
    }

    private async Task Cancel(Guid id)
    {
        var result = await Api.CancelAppointmentAsync(id, "Cancelled by clinic staff");
        message = result.Message;
        await Reload();
    }
}
