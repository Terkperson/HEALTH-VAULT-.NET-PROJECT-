@page "/"
@inject ToastService Toast

<div class="hero hero-with-bg-image">
    <div class="crumb" style="color:#cde8e4">Two-week MVP · .NET 8</div>
    <h1>Care records, appointments and clinic staff — in one vault.</h1>
    <p>Patients register, book and view records. Staff manage the floor. Administrators see the numbers. Built to the HealthVault SRS v1.1.</p>
    <a class="btn btn-light me-2" href="/login">Sign in</a>
    <a class="btn btn-outline-light" href="/register">Create a patient account</a>
</div>

<div class="stats">
    <div class="stat"><span>Auth</span><strong>JWT + roles</strong></div>
    <div class="stat"><span>Patients</span><strong>CRUD + search</strong></div>
    <div class="stat"><span>Appointments</span><strong>Status + slots</strong></div>
    <div class="stat"><span>Records</span><strong>Upload / view</strong></div>
</div>

<div class="card toast-demo-card">
    <div class="card-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
    </div>
    <h3>New: Toast Notifications</h3>
    <p class="mb-3">We've upgraded the UI with modern toast notifications. Try them out:</p>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-success" @onclick='() => Toast.ShowSuccess("Operation completed successfully!", "Success")'>
            Success Toast
        </button>
        <button class="btn btn-danger" @onclick='() => Toast.ShowError("Something went wrong. Please try again.", "Error")'>
            Error Toast
        </button>
        <button class="btn btn-info" @onclick='() => Toast.ShowInfo("Here is some helpful information for you.", "Info")'>
            Info Toast
        </button>
        <button class="btn btn-warning" @onclick='() => Toast.ShowWarning("Please review this before proceeding.", "Warning")'>
            Warning Toast
        </button>
    </div>
</div>

<div class="card demo-accounts-card">
    <div class="card-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
    </div>
    <h3>Demo accounts (after first API start)</h3>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Role</th><th>Email</th><th>Password</th></tr></thead>
            <tbody>
                <tr><td><span class="role-badge role-admin">Administrator</span></td><td>admin@healthvault.com</td><td><code>Admin@12345</code></td></tr>
                <tr><td><span class="role-badge role-staff">Staff</span></td><td>staff@healthvault.com</td><td><code>Staff@12345</code></td></tr>
                <tr><td><span class="role-badge role-staff">Staff (nurse)</span></td><td>nurse@healthvault.com</td><td><code>Staff@12345</code></td></tr>
                <tr><td><span class="role-badge role-patient">Patient</span></td><td>patient@healthvault.com</td><td><code>Patient@12345</code></td></tr>
            </tbody>
        </table>
    </div>
    <p class="mb-0 text-muted"><small>Point the API at your SQL Server, run the scripts in <code>database/</code>, then start HealthVault.Api and HealthVault.Web.</small></p>
</div>

@code {
    // Toast demo handlers are inline above
}
