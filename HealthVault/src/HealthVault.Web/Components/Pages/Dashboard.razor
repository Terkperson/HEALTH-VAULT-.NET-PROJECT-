@page "/dashboard"
@attribute [Authorize]
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
@inject ToastService Toast

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="lede">Welcome back, @Session.FullName.</p>
</div>

@if (patient is not null)
{
    <div class="stats">
        <div class="stat">
            <span>Upcoming</span>
            <strong>@patient.UpcomingAppointmentCount</strong>
        </div>
        <div class="stat">
            <span>Records</span>
            <strong>@patient.RecordCount</strong>
        </div>
    </div>
    <div class="card">
        <h3>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Upcoming appointments
        </h3>
        @if (patient.UpcomingAppointments.Any())
        {
            <AppointmentTable Items="patient.UpcomingAppointments" />
            <div class="card-actions">
                <a class="btn btn-teal" href="/appointments/book">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 6px;">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Book new appointment
                </a>
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; color: var(--muted);">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <p>No upcoming appointments</p>
                <a class="btn btn-teal" href="/appointments/book">Book your first appointment</a>
            </div>
        }
    </div>
    <div class="card">
        <h3>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Recent records
        </h3>
        @if (patient.RecentRecords.Any())
        {
            <RecordTable Items="patient.RecentRecords" />
        }
        else
        {
            <div class="empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; color: var(--muted);">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <p>No medical records yet</p>
            </div>
        }
    </div>
}

@if (staff is not null)
{
    <div class="stats">
        <div class="stat">
            <span>Today</span>
            <strong>@staff.TodayAppointmentCount</strong>
        </div>
        <div class="stat">
            <span>Pending</span>
            <strong>@staff.PendingAppointmentCount</strong>
        </div>
        <div class="stat">
            <span>New patients (14d)</span>
            <strong>@staff.RecentPatientCount</strong>
        </div>
    </div>
    <div class="card">
        <h3>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Today's appointments
        </h3>
        @if (staff.TodayAppointments.Any())
        {
            <AppointmentTable Items="staff.TodayAppointments" ShowPatient="true" />
        }
        else
        {
            <div class="empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; color: var(--muted);">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <p>No appointments scheduled for today</p>
            </div>
        }
    </div>
    <div class="card">
        <h3>⏳ Pending queue</h3>
        @if (staff.PendingAppointments.Any())
        {
            <AppointmentTable Items="staff.PendingAppointments" ShowPatient="true" />
        }
        else
        {
            <div class="empty-state">
                <div style="font-size: 48px; margin-bottom: 16px;">✓</div>
                <p>All caught up! No pending appointments</p>
            </div>
        }
    </div>
}

@if (admin is not null)
{
    <div class="stats">
        <div class="stat">
            <span>Users</span>
            <strong>@admin.UserCount</strong>
        </div>
        <div class="stat">
            <span>Patients</span>
            <strong>@admin.PatientCount</strong>
        </div>
        <div class="stat">
            <span>Staff</span>
            <strong>@admin.StaffCount</strong>
        </div>
        <div class="stat">
            <span>Appointments</span>
            <strong>@admin.AppointmentCount</strong>
        </div>
        <div class="stat">
            <span>Records</span>
            <strong>@admin.MedicalRecordCount</strong>
        </div>
    </div>
    <div class="card">
        <h3>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            Appointment Overview
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-bottom: 20px;">
            <div style="text-align: center; padding: 16px; background: rgba(180, 83, 9, 0.08); border-radius: 10px;">
                <div style="font-size: 24px; font-weight: 700; color: var(--warn);">@admin.PendingAppointments</div>
                <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Pending</div>
            </div>
            <div style="text-align: center; padding: 16px; background: rgba(29, 78, 216, 0.08); border-radius: 10px;">
                <div style="font-size: 24px; font-weight: 700; color: var(--info);">@admin.ConfirmedAppointments</div>
                <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Confirmed</div>
            </div>
            <div style="text-align: center; padding: 16px; background: rgba(4, 120, 87, 0.08); border-radius: 10px;">
                <div style="font-size: 24px; font-weight: 700; color: var(--ok);">@admin.CompletedAppointments</div>
                <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Completed</div>
            </div>
            <div style="text-align: center; padding: 16px; background: rgba(190, 18, 60, 0.08); border-radius: 10px;">
                <div style="font-size: 24px; font-weight: 700; color: var(--bad);">@admin.CancelledAppointments</div>
                <div style="font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Cancelled</div>
            </div>
        </div>
        <div class="card-actions">
            <a class="btn btn-teal" href="/admin/users">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 6px;">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                View users and roles
            </a>
        </div>
    </div>
}

@code {
    private PatientDashboardDto? patient;
    private StaffDashboardDto? staff;
    private AdminDashboardDto? admin;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Session.Role == UserRoles.Patient)
        {
            var result = await Api.PatientDashboardAsync();
            if (result.Success) patient = result.Data;
            else Toast.ShowError(result.Message ?? "Failed to load dashboard data", "Error");
        }
        else if (Session.Role is UserRoles.Staff or UserRoles.Administrator)
        {
            var result = await Api.StaffDashboardAsync();
            if (result.Success) staff = result.Data;
            else Toast.ShowError(result.Message ?? "Failed to load dashboard data", "Error");
        }

        if (Session.Role == UserRoles.Administrator)
        {
            var result = await Api.AdminDashboardAsync();
            if (result.Success) admin = result.Data;
            else Toast.ShowError(result.Message ?? "Failed to load admin data", "Error");
        }
    }
}
