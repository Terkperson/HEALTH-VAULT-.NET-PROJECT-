@page "/login"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav

<div class="auth-wrap card">
    <h1 class="page-title">Sign in</h1>
    <p class="lede">Use your clinic or patient account.</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <EditForm Model="model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="model.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText type="password" class="form-control" @bind-Value="model.Password" />
        </div>
        <button class="btn btn-teal w-100" type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
    </EditForm>
    <p class="mt-3 mb-0">New patient? <a href="/register">Create an account</a></p>
</div>

@code {
    private readonly LoginRequest model = new();
    private string? error;
    private bool busy;

    private async Task Submit()
    {
        busy = true;
        error = null;
        var result = await Api.LoginAsync(model);
        busy = false;
        if (!result.Success || result.Data is null)
        {
            error = result.Message;
            return;
        }
        Session.Set(result.Data);
        Nav.NavigateTo("/dashboard");
    }
}
